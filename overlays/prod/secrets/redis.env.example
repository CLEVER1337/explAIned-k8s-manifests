# cp redis.env.example redis.env and fill it in. redis.env is gitignored.
#
# Used two ways: as a StackExchange.Redis `password=` field by the .NET services, and inside a
# redis://:PASSWORD@host:port/0 URL by the Python ones. The URL form is the constraint —
# @ : / ? # and % have to be percent-encoded there or the URL parses into the wrong host.
# Keep it to [A-Za-z0-9_-] and the question never comes up.
REDIS_PASSWORD=
