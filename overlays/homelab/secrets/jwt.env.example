# cp jwt.env.example jwt.env and fill it in. jwt.env is gitignored.
#
# Not generated by Ansible — nothing in clever-homelab knows about explAIned's tokens. Make
# one and keep it:
#
#   openssl rand -base64 48
#
# Identity mints with it; article, comment, profile and recommendation validate with it. All
# five read this one Secret, which is the only thing keeping them in agreement. HS256 needs
# at least 32 bytes.
JWT_KEY=
