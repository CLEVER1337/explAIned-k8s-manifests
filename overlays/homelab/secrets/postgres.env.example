# cp postgres.env.example postgres.env and fill it in. postgres.env is gitignored.
#
# Generated by the postgres role on 10.42.0.20 and never leaves that guest on its own.
# `make secrets-pull` fetches all five; by hand it is:
#
#   ssh -J supervisor@<hypervisor> supervisor@10.42.0.20 \
#     'sudo cat /etc/homelab/pg_app_password'
#
# The account is `app`, which owns all four databases (asd, articles, comments, profiles).
# Rotating it means updating this file and rolling the four services that compose it into a
# connection string — the password is not read again after a pod starts.
POSTGRES_PASSWORD=
