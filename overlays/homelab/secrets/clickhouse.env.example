# cp clickhouse.env.example clickhouse.env and fill it in. clickhouse.env is gitignored.
#
#   ssh -J supervisor@<hypervisor> supervisor@10.42.0.21 \
#     'sudo cat /etc/homelab/clickhouse_app_password'
#
# Unlike the in-cluster ClickHouse, this one gives `default` nothing: that account is pinned
# to loopback, and the application connects as `app` with `GRANT ALL ON explained.*` and no
# CREATE DATABASE privilege. The schema Job expects exactly that and lets its CREATE DATABASE
# fail — the database is made by Ansible with clickhouse-client on the guest itself.
CLICKHOUSE_PASSWORD=
