# Real credentials. The .example files next to them are what belongs in git.
#
# These are not placeholders to be filled with something invented: four of the five are
# generated by clever-homelab on the database guests and only exist in /etc/homelab there.
# `make secrets-pull` fetches them.
overlays/homelab/secrets/*.env

# overlays/dev/secrets/*.env is deliberately NOT ignored — those are the values already
# published in the repo's appsettings.json, and committing them is what makes the dev overlay
# a one-command deploy.

# Rendered output, when someone runs `make build` to eyeball a diff.
/out/
*.rendered.yaml
